<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ruby Programming Challenge | Amey & Mega</title>
    <link rel="icon" type="image/png" href="assets/Ruby Logo.png">
    <link rel="stylesheet" href="style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Play:wght@400;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" rel="stylesheet" />

    <!-- PWA Metadata -->
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#CC0000">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="apple-touch-icon" href="assets/Ruby Logo.png">
</head>

<body>
    <!-- Premium Splash Loader -->
    <div id="skeleton-loader">
        <div class="loader-content">
            <div class="loader-ruby-wrapper">
                <div class="loader-ruby-icon" id="splash-ruby-icon">
                    <img src="assets/Ruby Logo.png" alt="Ruby Logo">
                </div>
                <div class="loader-progress-container">
                    <div id="splash-progress-bar"></div>
                </div>
            </div>
            <p class="loader-text pulse-text">Starting Ruby Challenge...</p>
        </div>
        <footer class="splash-footer">
            <p>Created by <a href="https://github.com/Amey-Thakur" class="author-link" target="_blank">Amey Thakur</a> &
                <a href="https://github.com/msatmod" class="author-link" target="_blank">Mega Satish</a> • &copy; 2022
            </p>
        </footer>
    </div>

    <div id="app">
        <header class="hero reveal">
            <div class="glass-panel">
                <div class="top-controls">
                    <button id="theme-toggle" class="control-btn" aria-label="Toggle Theme">
                        <i class="fas fa-moon"></i>
                    </button>
                    <button id="share-btn" class="control-btn" aria-label="Share Challenge">
                        <i class="fas fa-share-alt"></i>
                    </button>
                </div>
                <h1 class="premium-title">Ruby Programming <span class="gradient-text">Challenge</span></h1>
                <p class="subtitle">A disciplined 30-day collaborative challenge undertaken to master Ruby programming and Ruby on Rails development, featuring a structured curriculum from basic syntax to full-stack web engineering.</p>

                <div class="hero-identity-grid">
                    <div class="profile-unit">
                        <a href="https://github.com/Amey-Thakur" target="_blank" class="author-pill">
                            <img src="https://github.com/Amey-Thakur.png" alt="Amey">
                            <span>Amey Thakur</span>
                        </a>
                        <a href="https://github.com/Amey-Thakur/RUBY" class="repo-btn ripple" target="_blank">
                            <i class="fas fa-code-branch repo-icon"></i>
                            <span>Amey's Ruby Repo</span>
                        </a>
                    </div>

                    <div class="profile-unit">
                        <a href="https://github.com/msatmod" target="_blank" class="author-pill">
                            <img src="assets/Mega.png" alt="Mega">
                            <span>Mega Satish</span>
                        </a>
                        <a href="https://github.com/msatmod/Ruby" class="repo-btn ripple" target="_blank">
                            <i class="fas fa-code-branch repo-icon"></i>
                            <span>Mega's Ruby Repo</span>
                        </a>
                    </div>

                    <div class="profile-unit full-width" style="grid-column: 1 / -1; margin-top: 1rem; display: flex; justify-content: center;">
                         <a href="/manifesto" class="repo-btn ripple" style="background: linear-gradient(135deg, #CC0000, #990000); padding: 0.8rem 2rem; border-radius: 50px;">
                            <i class="fas fa-gem" style="margin-right: 8px;"></i>
                            <span>View Verbatim Manifesto (README.rb)</span>
                        </a>
                    </div>
                </div>

                <div class="hero-stats-divider"></div>

                <div id="progress" class="hero-stats-merge">
                    <div class="stats-top-row">
                        <div class="stat-unit">
                            <div class="stat-header">
                                <i class="fas fa-check-square stat-check-icon"></i>
                                <span class="stat-label">CURRICULUM MODULES</span>
                            </div>
                            <div class="stat-value-container">
                                <span id="milestone-count" class="stat-value">0</span>
                                <span class="stat-total">/ 30</span>
                            </div>
                        </div>
                        <div class="stat-unit align-right">
                            <div class="stat-header justify-end">
                                <span class="stat-label">PROJECTS BUILT</span>
                                <i class="fas fa-rocket stat-cert-icon"></i>
                            </div>
                            <div class="stat-value-container">
                                <span id="project-count" class="stat-value">0</span>
                            </div>
                        </div>
                    </div>

                    <div class="stats-animation-track">
                        <div class="stats-ruby-icon" id="stats-ruby-icon" onclick="animateStatsCard()" title="Click to Replay Analysis">
                            <img src="assets/Ruby Logo.png" width="24" height="24" alt="Ruby Logo">
                        </div>
                        <div class="stats-subtle-line"></div>
                    </div>

                    <div class="stat-center-unit">
                        <div id="mastery-count" class="stat-footer-value" style="color: var(--accent-ruby);">0%</div>
                        <div class="stat-footer-label">CHALLENGE MASTERY</div>
                    </div>
                </div>
            </div>
        </header>

        <main class="container">
            <section id="projects" class="project-section reveal">
                <h2 class="section-title">Ruby Projects</h2>
                <div class="project-grid">
                    <div class="project-card glass-panel" data-link="https://github.com/Amey-Thakur/RAILSFRIENDS">
                        <div class="project-icon-wrapper">
                            <img src="assets/Ruby on Rails Logo.png" alt="Rails Logo">
                        </div>
                        <h3>RailsFriends</h3>
                        <p>Full-stack web application with SQLite3 persistence.</p>
                        <a href="https://github.com/Amey-Thakur/RAILSFRIENDS" target="_blank" class="view-btn">View Code</a>
                    </div>
                    <div class="project-card glass-panel" data-link="https://github.com/Amey-Thakur/TIC-TAC-TOE-IN-RUBY">
                        <div class="project-icon-wrapper">
                            <i class="fas fa-th"></i>
                        </div>
                        <h3>TicTacToe</h3>
                        <p>Algorithmic implementation in pure Ruby.</p>
                        <a href="https://github.com/Amey-Thakur/TIC-TAC-TOE-IN-RUBY" target="_blank" class="view-btn">View Code</a>
                    </div>
                    <div class="project-card glass-panel" data-link="https://github.com/Amey-Thakur/HANGMAN-IN-RUBY">
                        <div class="project-icon-wrapper">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 21h10" />
                                <path d="M7 21V3" />
                                <path d="M7 3h10" />
                                <path d="M17 3v4" />
                                <circle cx="17" cy="9" r="2" />
                                <path d="M17 11v6" />
                                <path d="M14 13l3 2" />
                                <path d="M20 13l-3 2" />
                                <path d="M15 20l2-3 2 3" />
                            </svg>
                        </div>
                        <h3>Hangman</h3>
                        <p>Logic-driven lexical processing engine.</p>
                        <a href="https://github.com/Amey-Thakur/HANGMAN-IN-RUBY" target="_blank" class="view-btn">View Code</a>
                    </div>
                </div>
            </section>

            <section id="curriculum" class="curriculum-section reveal">
                <h2 class="section-title">Curriculum Explorer</h2>
                <div class="filter-bar">
                    <button class="filter-btn active" data-filter="all">All Modules</button>
                    <button class="filter-btn" data-filter="basics">Basics</button>
                    <button class="filter-btn" data-filter="logic">Logic</button>
                    <button class="filter-btn" data-filter="modular">Modular</button>
                    <button class="filter-btn" data-filter="advanced">Advanced</button>
                    <button class="filter-btn" data-filter="rails">Rails</button>
                </div>
                <div class="day-grid" id="day-grid">
                    <!-- Dynamic Grid generated by Ruby on Server -->
                    <% @curriculum.each do |item| %>
                    <div class="day-card glass-panel" 
                         data-category="<%= item[:category] %>"
                         data-files='<%= item[:files].to_json %>'
                         data-folder="<%= item[:folder_path] %>"
                         onclick="openArchiveExplorer(<%= item[:day] %>)">
                        <div class="card-header">
                            <div class="day-number">Day <%= item[:day] %></div>
                            <div class="mastery-pulse"></div>
                        </div>
                        <div class="day-title"><%= item[:topic] %></div>
                        <div class="day-footer">
                            <span class="category-tag"><%= item[:category].upcase %></span>
                            <div class="file-count">
                                <i class="fas fa-file-code"></i> <%= item[:files].length %> Sources
                            </div>
                        </div>
                    </div>
                    <% end %>
                </div>
            </section>
        </main>

        <footer class="main-footer">
            <p>Created by <a href="https://github.com/Amey-Thakur" class="author-link" target="_blank">Amey Thakur</a> &
                <a href="https://github.com/msatmod" class="author-link" target="_blank">Mega Satish</a> • &copy; 2022
            </p>
            <div class="footer-branding">
                <img src="assets/Ruby Logo.png" width="20" height="20" alt="Ruby"> Ruby Programming Challenge
            </div>
        </footer>

    </div>

    <!-- High-Fidelity Archive Explorer Modal -->
    <div id="archive-modal">
        <div class="archive-explorer glass-panel">
            <header class="archive-header">
                <div class="archive-info">
                    <h3 id="archive-title">Day 0: Loading...</h3>
                    <div class="breadcrumb">Ruby Challenge / <span id="archive-path">Source Code</span></div>
                </div>
                <div class="archive-controls">
                    <button id="download-btn" class="icon-btn" title="Download Source"><i class="fas fa-download"></i></button>
                    <button id="github-link-btn" class="icon-btn" title="View on GitHub"><i class="fab fa-github"></i></button>
                    <button id="copy-code-btn" class="icon-btn" title="Copy Code"><i class="fas fa-copy"></i></button>
                    <i class="fas fa-times close-archive"></i>
                </div>
            </header>
            <div class="archive-body">
                <aside class="file-sidebar">
                    <div class="sidebar-header">
                        <span>FILES</span>
                        <span class="badge" id="file-count-badge">0</span>
                    </div>
                    <ul id="file-list" class="file-list">
                        <!-- Injected via JS -->
                    </ul>
                </aside>
                <main class="code-viewer">
                    <div class="code-header">
                        <span id="current-file-name">script.rb</span>
                        <span class="language-tag">RUBY</span>
                    </div>
                    <pre id="archive-code-display" class="language-ruby"><code class="language-ruby"># Select a file to view source code...</code></pre>
                    <div class="execution-hint">
                        <i class="fas fa-terminal"></i>
                        <code>ruby <span id="archive-execution-script">script</span>.rb</code>
                    </div>
                </main>
            </div>
        </div>
    </div>

    <!-- Cinematic Easter Egg Overlay -->
    <button id="back-to-top" class="back-to-top"><i class="fas fa-arrow-up"></i></button>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-ruby.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/line-numbers/prism-line-numbers.min.js"></script>
    <script src="js/app.js"></script>
    <!-- Cinematic Easter Egg Overlay -->
    <div id="easter-egg-overlay">
        <div class="ee-content">
            <img src="assets/Ruby Logo.png" class="ee-ruby-glow" alt="Ruby Logo">
            <h2 class="ee-title">The Sacred Ruby Discovered</h2>
            <div id="ee-message-box" class="ee-message"></div>
            <p class="ee-close-hint">Click anywhere or press ESC to exit</p>
        </div>
    </div>
</body>

</html>
